{
  "name": "memfolio",
  "version": "0.1.1",
  "private": true,
  "description": "Browser extension that saves media from social platforms into local folders, incrementally.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "build:firefox": "node scripts/build.mjs --firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --e2e && node tests/e2e/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:firefox"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/wicg-file-system-access": "^2023.10.5",
    "esbuild": "^0.24.0",
    "puppeteer": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
